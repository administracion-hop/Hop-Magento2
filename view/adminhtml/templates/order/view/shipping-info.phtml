<?php
/**
 * @var \Hop\Envios\Block\Adminhtml\Order\View\ShippingInfo $block
 * @var \Magento\Framework\Escaper $escaper
 */
$info = $block->getSelectedPickupPointData();
$dispatch = $block->getDispatchInfo();
$order = $block->getOrder();

?>

<?php if (!empty($info) || !empty($dispatch)): ?>
<div class="admin__page-section-item order-shipping-custom-info">
    <div class="admin__page-section-item-title">
        <span class="title"><?= __('Información Hop Envíos') ?></span>
    </div>
    <div class="admin__page-section-item-content">
        <div class="admin__table-wrapper">
            <table class="admin__table-secondary">
                <tbody>
                    <?php if (!empty($dispatch)): ?>
                    <tr>
                        <th><?= __('Estado del despacho') ?></th>
                        <td>
                            <span class="hop-dispatch-status hop-dispatch-status--<?= $escaper->escapeHtmlAttr($dispatch['status']) ?>">
                                <?= $escaper->escapeHtml($dispatch['status_label']) ?>
                            </span>
                            <?php if ($dispatch['is_failed']): ?>
                                <div class="hop-dispatch-retry">
                                    <?php if ($dispatch['next_retry_at']): ?>
                                        <?= $escaper->escapeHtml(__('Intento %1 de %2. Próximo reintento automático: %3.', $dispatch['attempts'], $dispatch['max_attempts'], $dispatch['next_retry_at'])) ?>
                                    <?php elseif ($dispatch['attempts'] < $dispatch['max_attempts']): ?>
                                        <?= $escaper->escapeHtml(__('No se reintenta solo: hay que corregir el problema y usar "Enviar a HOP".')) ?>
                                    <?php else: ?>
                                        <?= $escaper->escapeHtml(__('Intento %1 de %2. Sin más reintentos automáticos: corregí el problema y usá "Enviar a HOP".', $dispatch['attempts'], $dispatch['max_attempts'])) ?>
                                    <?php endif; ?>
                                </div>
                            <?php endif; ?>
                        </td>
                    </tr>
                    <?php if ($dispatch['is_failed'] && !empty($dispatch['last_error'])): ?>
                    <tr>
                        <th><?= __('Motivo del rechazo') ?></th>
                        <td><?= $escaper->escapeHtml($dispatch['last_error']) ?></td>
                    </tr>
                    <tr>
                        <th><?= __('Cómo resolverlo') ?></th>
                        <td class="hop-dispatch-cta">
                            <?php if ($dispatch['instruction']): ?>
                                <?= $escaper->escapeHtml($dispatch['instruction']) ?>
                                <?php if ($dispatch['config_url']): ?>
                                    <br><a href="<?= $escaper->escapeUrl($dispatch['config_url']) ?>" target="_blank"><?= __('Abrir configuración de Hop') ?></a>
                                <?php endif; ?>
                            <?php else: ?>
                                <?= __('Revisá el motivo de arriba, corregilo y apretá "Enviar a HOP" para reintentar. Si no está claro qué lo causa, consultá a soporte de Hop con este mensaje.') ?>
                            <?php endif; ?>
                        </td>
                    </tr>
                    <?php endif; ?>
                    <?php endif; ?>
                    <?php if (!empty($info['pickup_point_id'])): ?>
                    <tr>
                        <th><?= __('Punto seleccionado actualmente') ?></th>
                        <td><?= $escaper->escapeHtml($info['pickup_point_id']) ?></td>
                    </tr>
                    <?php endif; ?>
                    <?php if (!empty($info['original_pickup_point_id'])): ?>
                    <tr>
                        <th><?= __('Punto seleccionado en el checkout') ?></th>
                        <td><?= $escaper->escapeHtml($info['original_pickup_point_id']) ?></td>
                    </tr>
                    <?php endif; ?>
                    <?php if (!empty($info['original_shipping_description'])): ?>
                    <tr>
                        <th><?= __('Descripción original') ?></th>
                        <td><?= $escaper->escapeHtml($info['original_shipping_description']) ?></td>
                    </tr>
                    <?php endif; ?>
                </tbody>
            </table>
        </div>
    </div>
</div>
<?php endif; ?>

